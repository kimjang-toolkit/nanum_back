{
    "compilerOptions": {
      "target": "es2022",
      "strict": true,
      "preserveConstEnums": true,
      "noEmit": true,
      "sourceMap": false,
      "module":"es2015",
      "moduleResolution":"node",
      "esModuleInterop": true, 
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,  
      "baseUrl": "./",
      "preserveValueImports": false,
      "allowJs": true,  // JS 파일을 TypeScript에서 사용할 수 있도록 허용
      "checkJs": false,  // (선택 사항) JS 파일에 대한 타입 검사를 비활성화
      "paths": {
        "@domain/*": ["../api-interface/src/domain/*"],
        "@interface/*": ["../api-interface/src/interface/*"],
        "@cobuying/*": [
          "../event-func/cobuying/*", 
        ],
        "@user/*": [
          "../event-func/user/*", 
        ],
        "@product/*": [
          "../event-func/product/*", 
        ],
        "@auth/*": [
          "../event-func/auth/*", 
        ],
        "@application/*": [
          "../event-func/application/*", 
        ],
        "@manage/*": [
          "../event-func/manage/*", 
        ],
        "@connect/*": [
          "../event-func/connect/*"
        ],
        "@common/*": ["../event-func/common/*"],
        "@query-interface/*": ["../event-func/query-interface/*"]
    }
    },
    // "exclude": ["node_modules", "**/*.test.ts"]
  }